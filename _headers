# Security + caching headers for Cloudflare Pages.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

# Phone screenshots are marketing assets that may be replaced without changing page layout.
/assets/screen-*
  Cache-Control: public, max-age=3600, must-revalidate

# Other images/fonts in /assets are long-lived; safe to cache hard.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# CSS/JS use stable (non-hashed) filenames, so do NOT mark immutable.
# Cache for an hour but allow revalidation so edits ship promptly.
/*.css
  Cache-Control: public, max-age=3600, must-revalidate

/*.js
  Cache-Control: public, max-age=3600, must-revalidate

# HTML must revalidate so content updates show right away.
/*.html
  Cache-Control: public, max-age=0, must-revalidate
